<?xml version="1.0" encoding="UTF-8"?>
<GenAiFunction xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>This topic is triggered when a user confirms that they have uploaded their claim documents. The InsureBuddy agent validates the claim record and initiates a backend review by another agent (ClaimEase) to check for completeness of the submitted documentation.</description>
    <invocationTarget>Communicate_Claimease_Agent_Flow</invocationTarget>
    <invocationTargetType>flow</invocationTargetType>
    <isConfirmationRequired>false</isConfirmationRequired>
    <isIncludeInProgressIndicator>true</isIncludeInProgressIndicator>
    <mappingAttributes>
        <label>AgentResponse</label>
        <name>output_AgentResponse</name>
        <parameterName>AgentResponse</parameterName>
        <parameterType>output</parameterType>
    </mappingAttributes>
    <masterLabel>Claimease Agent Action</masterLabel>
    <progressIndicatorMessage>Connecting ClaimEase Agent....</progressIndicatorMessage>
</GenAiFunction>
